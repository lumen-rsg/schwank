{
  "name": "schwank",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run server:dev",
    "build": "npm run server:build",
    "start": "npm run server:start",
    "start:lan": "npm run server:start:lan",
    "server:dev": "vinext dev",
    "server:build": "vinext build",
    "server:start": "wrangler dev --config dist/server/wrangler.json --assets dist/client --persist-to .wrangler/state",
    "server:start:lan": "wrangler dev --config dist/server/wrangler.json --assets dist/client --ip 0.0.0.0 --port 3000 --persist-to .wrangler/state",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:check": "node --test desktop/*.test.mjs",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist:mac": "electron-builder --mac --arm64",
    "desktop:dist:linux": "electron-builder --linux AppImage --x64",
    "desktop:dist:windows": "electron-builder --win --x64",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:deployment && npm run server:build && npm run test:integration",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "test": "npm run test:unit && npm run desktop:check",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:deployment": "sh -n deploy/orange-pi/backup.sh deploy/orange-pi/verify-backup.sh && node --test tests/deployment-backup.test.mjs",
    "test:unit": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
